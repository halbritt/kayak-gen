FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// case_template_version ${case_template_version}
// Stage: interFoam solve

application     interFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         ${end_time};

deltaT          ${delta_t};

writeControl    adjustable;
writeInterval   ${write_interval};

purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable false;

adjustTimeStep  yes;
maxCo           5;
maxAlphaCo      2;
maxDeltaT       0.05;

functions
{
    forces
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (${forces_patch_name});
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          ${rho_inf};
        log             true;
        CofR            (${cofr_x} ${cofr_y} ${cofr_z});
    }
}
