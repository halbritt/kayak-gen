FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

// case_template_version ${case_template_version}

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    boxToCell
    {
        box (${x_min} ${y_min} ${z_min}) (${x_max} ${y_max} ${waterline_z});
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);
