FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

// case_template_version ${case_template_version}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (${inlet_speed_ms} 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (${inlet_speed_ms} 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (${inlet_speed_ms} 0 0);
    }
    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            symmetryPlane;
    }
    leftSide
    {
        type            symmetryPlane;
    }
    rightSide
    {
        type            symmetryPlane;
    }
    hull
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}
