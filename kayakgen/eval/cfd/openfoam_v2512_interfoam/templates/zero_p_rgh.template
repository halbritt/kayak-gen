FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

// case_template_version ${case_template_version}

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    outlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    atmosphere
    {
        type            totalPressure;
        p0              uniform 0;
    }
    bottom
    {
        type            symmetryPlane;
    }
    leftSide
    {
        type            symmetryPlane;
    }
    rightSide
    {
        type            symmetryPlane;
    }
    hull
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}
