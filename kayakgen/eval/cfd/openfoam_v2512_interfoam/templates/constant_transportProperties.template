FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

// case_template_version ${case_template_version}

phases (water air);

water
{
    transportModel  Newtonian;
    nu              ${water_nu};
    rho             ${water_rho};
}

air
{
    transportModel  Newtonian;
    nu              ${air_nu};
    rho             ${air_rho};
}

sigma           0.0;
