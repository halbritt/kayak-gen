{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0010-rfc-completion-review-remediation",
  "workflow_version": "2026-05-12",
  "name": "0010 - RFC completion review and remediation",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0010-rfc-completion-review-remediation",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "claude"
  },
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": [
        "claude",
        "--model",
        "opus",
        "-p"
      ],
      "capabilities": [
        "review",
        "synthesis"
      ]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex",
        "exec",
        "--model",
        "gpt-5.5",
        "-"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": [
        "gemini",
        "--model",
        "gemini-3.1-pro-preview"
      ],
      "capabilities": [
        "review"
      ]
    }
  },
  "roles": {
    "coordinator": {
      "definition_path": "roles/coordinator.md"
    },
    "reviewer_traceability": {
      "definition_path": "roles/reviewer_traceability.md"
    },
    "reviewer_arch_domain": {
      "definition_path": "roles/reviewer_arch_domain.md"
    },
    "reviewer_interface_ops": {
      "definition_path": "roles/reviewer_interface_ops.md"
    },
    "ledger": {
      "definition_path": "roles/ledger.md"
    },
    "implementer": {
      "definition_path": "roles/implementer.md"
    },
    "final_reviewer": {
      "definition_path": "roles/final_reviewer.md"
    }
  },
  "context_docs": [
    {
      "path": "AGENTS.md",
      "required": true
    },
    {
      "path": "docs/PRD.md",
      "required": true
    },
    {
      "path": "docs/design/kayak_hull_design_constraints.md",
      "required": true
    },
    {
      "path": "docs/rfcs/README.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0002-gui-usability.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0003-layout-and-station-view.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0004-plumb-bow.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0005-cfd-resistance.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0006-design-constraints.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0007-architectural-revisit.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0008-web-frontend.md",
      "required": true
    },
    {
      "path": "docs/rfcs/0002-0003-audit.md",
      "required": false
    },
    {
      "path": "docs/workflows/0010-rfc-completion-review-remediation/SOURCES.md",
      "required": true
    },
    {
      "path": "pyproject.toml",
      "required": true
    },
    {
      "path": "Dockerfile",
      "required": false
    },
    {
      "path": "generator.py",
      "required": true
    },
    {
      "path": "gui.py",
      "required": true
    },
    {
      "path": "pyvista_view.py",
      "required": true
    }
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review RFC traceability and acceptance status across RFCs 0002-0008",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Revisit every non-template RFC from 0002 through the current latest RFC 0008. Build an RFC-by-RFC acceptance matrix against the current repo, including implementation, tests, docs, and any explicit deferrals. Flag missing acceptance criteria, over-claimed completion, and stale RFC text.",
      "task_prompt": {
        "path": "prompts/review_traceability.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "striatum/0010-rfc-completion-review-remediation/claude/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0010-rfc-completion-review-remediation/claude/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_arch_domain",
      "type": "review",
      "title": "Review architecture, domain model, geometry, hydrostatics, and resistance",
      "role_id": "reviewer_arch_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Audit the RFC 0007 package extraction and the domain/math work promised by RFCs 0004, 0005, and 0006. Check module boundaries, compatibility shims, schema contracts, numerical methods, presets, and regression coverage.",
      "task_prompt": {
        "path": "prompts/review_arch_domain.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "striatum/0010-rfc-completion-review-remediation/gemini/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0010-rfc-completion-review-remediation/gemini/REVIEW_ARCH_DOMAIN.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_interface_ops",
      "type": "review",
      "title": "Review desktop, web, CLI, packaging, tests, and workflow integrity",
      "role_id": "reviewer_interface_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Audit the user-facing and operational surface from RFCs 0002, 0003, 0007, and 0008: desktop GUI, station view, CLI commands, Trame web layer, Docker/package extras, test execution, and Striatum workflow hygiene.",
      "task_prompt": {
        "path": "prompts/review_interface_ops.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "striatum/0010-rfc-completion-review-remediation/codex-review/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0010-rfc-completion-review-remediation/codex-review/REVIEW_INTERFACE_OPS.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Merge the three RFC completion reviews into one remediation ledger",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Read the three review artifacts, deduplicate overlapping findings, normalize severity, preserve dissent, and produce a single ledger that separates actionable code/test fixes from documentation/process-only findings.",
      "task_prompt": {
        "path": "prompts/findings_ledger.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0010-rfc-completion-review-remediation/ledger/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0010-rfc-completion-review-remediation/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement accepted remediation from the findings ledger",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Correct every actionable blocker and major finding from the ledger, preferring focused code/test/doc patches over broad rewrites. Use Codex for implementation. If a finding is non-actionable or requires a human decision, document that explicitly instead of guessing.",
      "task_prompt": {
        "path": "prompts/implement_findings.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "generator.py",
          "gui.py",
          "pyvista_view.py",
          "kayakgen/",
          "tests/",
          "docs/",
          "Dockerfile",
          "pyproject.toml",
          "requirements-dev.txt",
          "striatum/0010-rfc-completion-review-remediation/implementation/"
        ],
        "forbidden_paths": [
          ".striatum/",
          ".codex/",
          ".claude/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0010-rfc-completion-review-remediation/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate: verify findings remediation and remaining risk",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify the implementation against the consolidated ledger and patch summary. Accept only if every actionable blocker/major finding is fixed or explicitly escalated with a defensible reason. On needs_revision, send the run back to Codex implementation once.",
      "task_prompt": {
        "path": "prompts/final_review.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "striatum/0010-rfc-completion-review-remediation/final/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0010-rfc-completion-review-remediation/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "review_traceability",
      "to": "findings_ledger",
      "on": "completed"
    },
    {
      "from": "review_arch_domain",
      "to": "findings_ledger",
      "on": "completed"
    },
    {
      "from": "review_interface_ops",
      "to": "findings_ledger",
      "on": "completed"
    },
    {
      "from": "findings_ledger",
      "to": "implement_findings",
      "on": "completed"
    },
    {
      "from": "implement_findings",
      "to": "final_review",
      "on": "completed"
    }
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
