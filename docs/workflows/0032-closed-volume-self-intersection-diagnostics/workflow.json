  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review self-intersection traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0016 and RFC 0021 requirements to current diagnostics, tests, docs, and deferrals.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0032-closed-volume-self-intersection-diagnostics/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0032-closed-volume-self-intersection-diagnostics/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review self-intersection geometry policy",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify body-level intersection policy, tolerance semantics, and ambiguous-case handling.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0032-closed-volume-self-intersection-diagnostics/domain/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0032-closed-volume-self-intersection-diagnostics/domain/REVIEW_DOMAIN.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops_test",
      "type": "review",
      "title": "Review self-intersection ops and tests",
      "role_id": "reviewer_ops_test",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify deterministic fixtures, serialization, compatibility, performance bounds, and test coverage.",
      "task_prompt": {"path": "prompts/review_ops_test.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0032-closed-volume-self-intersection-diagnostics/ops/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0032-closed-volume-self-intersection-diagnostics/ops/REVIEW_OPS_TEST.md",
          "required": true
        }
      ]
