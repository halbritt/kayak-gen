{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0035-high-angle-gz-generated-body-handoff",
  "workflow_version": "2026-05-13",
  "name": "0035 - High-angle GZ generated-body handoff",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0035-high-angle-gz-generated-body-handoff",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain": {"definition_path": "roles/reviewer_domain.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/rfcs/0011-hydrostatic-stability-load-cases.md", "required": true},
    {"path": "docs/rfcs/0014-generalized-trim-and-gz-stability.md", "required": true},
    {"path": "docs/rfcs/0016-closed-volume-geometry.md", "required": true},
    {"path": "docs/rfcs/0020-high-angle-gz-secondary-stability.md", "required": true},
    {"path": "docs/rfcs/0024-high-angle-gz-generated-body-handoff.md", "required": true},
    {"path": "kayakgen/eval/closed_volume.py", "required": true},
    {"path": "kayakgen/eval/hydrostatics.py", "required": true},
    {"path": "kayakgen/eval/stability.py", "required": true},
    {"path": "kayakgen/cli/main.py", "required": true},
    {"path": "tests/test_closed_volume.py", "required": true},
    {"path": "tests/test_stability.py", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review generated-body GZ traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0014, RFC 0016, RFC 0020, and RFC 0024 requirements to current GZ availability and closed-volume diagnostics.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0035-high-angle-gz-generated-body-handoff/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review generated-body GZ domain",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review body_ref semantics, heel grid, CG assumptions, synthetic fixture boundaries, warnings, and summary metrics.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0035-high-angle-gz-generated-body-handoff/domain/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/domain/REVIEW_DOMAIN.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review generated-body GZ ops and tests",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review unavailable behavior, fixture-only labeling, CLI/sweep/UI hiding, JSON compatibility, and tests.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0035-high-angle-gz-generated-body-handoff/ops/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/ops/REVIEW_OPS.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate generated-body GZ findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate findings and define the safe implementation slice for RFC 0024.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0035-high-angle-gz-generated-body-handoff/ledger/",
          "docs/workflows/0035-high-angle-gz-generated-body-handoff/OPERATOR_REPORT.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement generated-body GZ handoff",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement only the RFC 0024 ledger-approved handoff without claiming real stability from fixtures.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/",
          "kayakgen/eval/",
          "kayakgen/cli/",
          "kayakgen/ui/",
          "tests/",
          "striatum/0035-high-angle-gz-generated-body-handoff/implementation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for generated-body GZ",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify real GZ remains gated on generated closed-body diagnostics and fixture output cannot claim kayak stability.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0035-high-angle-gz-generated-body-handoff/final/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0035-high-angle-gz-generated-body-handoff/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
