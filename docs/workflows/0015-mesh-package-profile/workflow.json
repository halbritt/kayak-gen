{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0015-mesh-package-profile",
  "workflow_version": "2026-05-13",
  "name": "0015 - Mesh package and solver profile",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0015-mesh-package-profile",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain": {"definition_path": "roles/reviewer_domain.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/rfcs/0010-cfd-ready-mesh-contract.md", "required": true},
    {"path": "docs/rfcs/0004-plumb-bow.md", "required": true},
    {"path": "docs/rfcs/0008-web-frontend.md", "required": true},
    {"path": "docs/workflows/0012-resistance-calibration-source-review/QUEUE.md", "required": true},
    {"path": "docs/workflows/0015-mesh-package-profile/SOURCES.md", "required": true},
    {"path": "striatum/0011-pipeline-pivot-rfcs/ledger/FINDINGS.md", "required": true},
    {"path": "kayakgen/eval/mesh_diagnostics.py", "required": true},
    {"path": "kayakgen/eval/cfd.py", "required": true},
    {"path": "kayakgen/cli/main.py", "required": true},
    {"path": "kayakgen/io/stl.py", "required": true},
    {"path": "tests/test_mesh_diagnostics.py", "required": true},
    {"path": "tests/test_cli.py", "required": true},
    {"path": "pyproject.toml", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review mesh-package traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review RFC 0010 acceptance traceability for mesh package and profile work.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0015-mesh-package-profile/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0015-mesh-package-profile/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review mesh profile semantics",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review open-surface profile, coordinate metadata, and readiness semantics.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0015-mesh-package-profile/domain/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0015-mesh-package-profile/domain/REVIEW_DOMAIN.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review mesh package implementation shape",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review implementation and tests for mesh package artifacts and CLI.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0015-mesh-package-profile/ops/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0015-mesh-package-profile/ops/REVIEW_OPS.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate mesh-package findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate mesh-package findings and define the safe patch.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0015-mesh-package-profile/ledger/",
          "docs/workflows/0015-mesh-package-profile/OPERATOR_REPORT.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0015-mesh-package-profile/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement mesh package and profile",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement safe mesh package/profile code, CLI, and tests from the ledger.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/rfcs/",
          "docs/workflows/0015-mesh-package-profile/",
          "kayakgen/",
          "tests/",
          "striatum/0015-mesh-package-profile/implementation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0015-mesh-package-profile/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for mesh package and profile",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify mesh-package truthfulness, determinism, and readiness semantics.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0015-mesh-package-profile/final/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0015-mesh-package-profile/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
