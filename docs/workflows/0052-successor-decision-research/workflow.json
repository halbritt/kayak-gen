{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0052-successor-decision-research",
  "workflow_version": "2026-05-14",
  "name": "0052 - Successor decision research",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0052-successor-decision-research",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "claude"
  },
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": [
        "claude",
        "--model",
        "opus",
        "-p"
      ],
      "capabilities": [
        "review",
        "synthesis"
      ]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex",
        "exec",
        "--model",
        "gpt-5.5",
        "--dangerously-bypass-approvals-and-sandbox",
        "-"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": [
        "gemini",
        "--model",
        "gemini-3.1-pro-preview"
      ],
      "capabilities": [
        "review",
        "synthesis"
      ]
    }
  },
  "roles": {
    "coordinator": {
      "definition_path": "roles/coordinator.md"
    },
    "researcher": {
      "definition_path": "roles/researcher.md"
    },
    "panelist": {
      "definition_path": "roles/panelist.md"
    },
    "decision_integrator": {
      "definition_path": "roles/decision_integrator.md"
    },
    "final_reviewer": {
      "definition_path": "roles/final_reviewer.md"
    }
  },
  "context_docs": [
    {
      "path": "AGENTS.md",
      "required": true
    },
    {
      "path": "docs/PRD.md",
      "required": true
    },
    {
      "path": "docs/USER_GUIDE.md",
      "required": true
    },
    {
      "path": "docs/ROADMAP.md",
      "required": true
    },
    {
      "path": "docs/DECISION_LOG.md",
      "required": true
    },
    {
      "path": "docs/rfcs/README.md",
      "required": true
    },
    {
      "path": "docs/design/kayak_hull_design_constraints.md",
      "required": true
