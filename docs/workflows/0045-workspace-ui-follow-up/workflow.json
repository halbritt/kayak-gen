{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0045-workspace-ui-follow-up",
  "workflow_version": "2026-05-14",
  "name": "0045 - Workspace UI follow-up",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0045-workspace-ui-follow-up",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {"adapter": "process", "display_model": "Claude Opus 4.7", "command": ["claude", "--model", "opus", "-p"], "capabilities": ["review", "synthesis"]},
    "codex": {"adapter": "process", "display_model": "Codex GPT-5.5", "command": ["codex", "exec", "--model", "gpt-5.5", "-"], "capabilities": ["write", "review", "synthesis"]},
    "gemini": {"adapter": "process", "display_model": "Gemini Pro 3.1", "command": ["gemini", "--model", "gemini-3.1-pro-preview"], "capabilities": ["review"]}
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "review_remediator": {"definition_path": "roles/review_remediator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain": {"definition_path": "roles/reviewer_domain.md"},
    "reviewer_ergonomics_design": {"definition_path": "roles/reviewer_ergonomics_design.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/PRD.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "docs/design/kayak_hull_design_constraints.md", "required": true},
    {"path": "docs/rfcs/0033-workspace-ui-rework.md", "required": true},
    {"path": "docs/rfcs/0034-workspace-ui-follow-up.md", "required": true},
    {"path": "striatum/0044-workspace-ui-rework/final/FINAL_REVIEW.md", "required": true},
    {"path": "striatum/0044-workspace-ui-rework/ledger/FINDINGS.md", "required": true},
    {"path": "striatum/0044-workspace-ui-rework/implementation/PATCH_SUMMARY.md", "required": true},
    {"path": "kayakgen/model/classes.py", "required": false},
    {"path": "kayakgen/model/advisory.py", "required": false},
    {"path": "kayakgen/ui/web/app.py", "required": false},
    {"path": "kayakgen/ui/web/controllers.py", "required": false},
    {"path": "kayakgen/ui/theme.py", "required": false},
    {"path": "tests", "required": true}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 4, "require_disjoint_write_scopes": true},
  "review_revision_policy": {
    "root_review_needs_revision": "declared_cycle",
    "description": "First-pass review needs_revision verdicts cycle to review_remediation before re-review."
  },
  "jobs": [
    {
      "id": "review_remediation",
      "type": "synthesis",
      "title": "Prepare or remediate first-pass review packet",
      "role_id": "review_remediator",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Prepare initial review context for RFC 0034 and, on needs_revision cycles, remediate first-pass reviewer-blocking RFC/workflow issues before re-review.",
      "task_prompt": {"path": "prompts/review_remediation.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/rfcs/0034-workspace-ui-follow-up.md",
          "docs/rfcs/README.md",
          "docs/workflows/0045-workspace-ui-follow-up/",
          "CHANGELOG.md",
          "striatum/0045-workspace-ui-follow-up/review_remediation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [{"logical_name": "review_remediation", "kind": "synthesis", "path": "striatum/0045-workspace-ui-follow-up/review_remediation/REMEDIATION.md", "required": true}]
    },
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review RFC 0034 traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify that RFC 0034 maps exactly to workflow 0044 final-review findings and RFC 0033 acceptance criteria without expanding scope.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/traceability/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0045-workspace-ui-follow-up/traceability/REVIEW_TRACEABILITY.md", "required": true}]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review no-claims and domain boundaries",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify that RFC 0034 UI wiring cannot imply calibrated drag, final prediction, high-angle GZ, hosted workers, watertight cfd_ready, or design fitness.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/domain/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0045-workspace-ui-follow-up/domain/REVIEW_DOMAIN.md", "required": true}]
    },
    {
      "id": "review_ergonomics_design",
      "type": "review",
      "title": "Review ergonomics and interaction design",
      "role_id": "reviewer_ergonomics_design",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review preset interaction, badge behavior, card wiring, export affordances, scan path, accessibility, and expert-workspace ergonomics.",
      "task_prompt": {"path": "prompts/review_ergonomics_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/ergonomics/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0045-workspace-ui-follow-up/ergonomics/REVIEW_ERGONOMICS_DESIGN.md", "required": true}]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review ops, accessibility, and tests",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review test strategy, browser acceptance, export safety, package boundaries, and implementation feasibility for RFC 0034.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/ops/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0045-workspace-ui-follow-up/ops/REVIEW_OPS.md", "required": true}]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate RFC 0034 findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate first-pass findings into the safest implementation slice for RFC 0034.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/ledger/", "docs/workflows/0045-workspace-ui-follow-up/OPERATOR_REPORT.md"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "ledger", "kind": "findings_ledger", "path": "striatum/0045-workspace-ui-follow-up/ledger/FINDINGS.md", "required": true}]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement RFC 0034 safe slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement the accepted RFC 0034 safe-now UI follow-up findings with tests and docs.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/", "kayakgen/", "tests/", "CHANGELOG.md", "striatum/0045-workspace-ui-follow-up/implementation/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0045-workspace-ui-follow-up/implementation/PATCH_SUMMARY.md", "required": true}]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for RFC 0034",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify RFC 0034 implementation against ledger, tests, docs, and no-claims constraints.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0045-workspace-ui-follow-up/final/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "final_review", "kind": "finding", "path": "striatum/0045-workspace-ui-follow-up/final/FINAL_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "review_remediation", "to": "review_traceability", "on": "completed"},
    {"from": "review_remediation", "to": "review_domain", "on": "completed"},
    {"from": "review_remediation", "to": "review_ergonomics_design", "on": "completed"},
    {"from": "review_remediation", "to": "review_ops", "on": "completed"},
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ergonomics_design", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_traceability", "to": "review_remediation", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_domain", "to": "review_remediation", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_ergonomics_design", "to": "review_remediation", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_ops", "to": "review_remediation", "on_verdict": "needs_revision", "max_iterations": 1, "allow_same_lane": true},
    {"from": "final_review", "to": "implement_findings", "on_verdict": "needs_revision", "max_iterations": 1}
  ]
}
