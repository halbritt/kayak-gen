  },
  "roles": {
    "coordinator": {
      "definition_path": "roles/coordinator.md"
    },
    "implementer": {
      "definition_path": "roles/implementer.md"
    }
  },
  "context_docs": [
    "docs/rfcs/0003-layout-and-station-view.md",
    "gui.py"
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "implement",
      "type": "build",
      "title": "Implement RFC 0003",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "Fix layout overlap, rename Sheer Plan, add interactive station cross-section view.",
      "task_prompt": {
        "path": "docs/workflows/layout-station-view.json/prompts/implement.md"
