{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "layout-station-view",
  "workflow_version": "2026-05-09",
  "name": "Layout Fix, Sheer Plan Rename, Interactive Station View (Codex)",
  "branch": {
    "mode": "auto",
