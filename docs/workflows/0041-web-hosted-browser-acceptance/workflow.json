{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0041-web-hosted-browser-acceptance",
  "workflow_version": "2026-05-13",
  "name": "0041 - Web hosted browser acceptance",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0041-web-hosted-browser-acceptance",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {"adapter": "process", "display_model": "Claude Opus 4.7", "command": ["claude", "--model", "opus", "-p"], "capabilities": ["review", "synthesis"]},
    "codex": {"adapter": "process", "display_model": "Codex GPT-5.5", "command": ["codex", "exec", "--model", "gpt-5.5", "-"], "capabilities": ["write", "review", "synthesis"]},
    "gemini": {"adapter": "process", "display_model": "Gemini Pro 3.1", "command": ["gemini", "--model", "gemini-3.1-pro-preview"], "capabilities": ["review"]}
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_browser": {"definition_path": "roles/reviewer_browser.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/rfcs/0008-web-frontend.md", "required": true},
    {"path": "docs/rfcs/0030-web-hosted-browser-acceptance.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "kayakgen/ui/web", "required": false},
    {"path": "kayakgen/cli", "required": false},
    {"path": "tests/test_web.py", "required": false},
    {"path": "tests/test_web_browser.py", "required": false},
    {"path": "Dockerfile", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review web acceptance traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0030 to RFC 0008 partials, web UI behavior, route scaffolding, deployment docs, and tests.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0041-web-hosted-browser-acceptance/traceability/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0041-web-hosted-browser-acceptance/traceability/REVIEW_TRACEABILITY.md", "required": true}]
    },
    {
      "id": "review_browser",
      "type": "review",
      "title": "Review browser acceptance",
      "role_id": "reviewer_browser",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review real-browser acceptance, console-clean/Lighthouse gates, 3D nonblank checks, share/export behavior, and plot parity boundaries.",
      "task_prompt": {"path": "prompts/review_browser.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0041-web-hosted-browser-acceptance/browser/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0041-web-hosted-browser-acceptance/browser/REVIEW_BROWSER.md", "required": true}]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review web ops and tests",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review hosted-demo runbook, Docker/local serve behavior, CI profiles, CFD route dependency states, and tests.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0041-web-hosted-browser-acceptance/ops/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0041-web-hosted-browser-acceptance/ops/REVIEW_OPS.md", "required": true}]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate web acceptance findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate review findings and define the safe implementation slice for RFC 0030.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["striatum/0041-web-hosted-browser-acceptance/ledger/", "docs/workflows/0041-web-hosted-browser-acceptance/OPERATOR_REPORT.md"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "ledger", "kind": "findings_ledger", "path": "striatum/0041-web-hosted-browser-acceptance/ledger/FINDINGS.md", "required": true}]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement hosted browser acceptance",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement accepted hosted/browser acceptance work while preserving explicit unavailable states for incomplete CFD routes.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/", "kayakgen/ui/web/", "kayakgen/cli/", "tests/", "Dockerfile", ".dockerignore", "striatum/0041-web-hosted-browser-acceptance/implementation/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0041-web-hosted-browser-acceptance/implementation/PATCH_SUMMARY.md", "required": true}]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for web acceptance",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify hosted demo docs, browser gates, console-clean/Lighthouse acceptance, parity boundaries, and CFD route dependency states.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0041-web-hosted-browser-acceptance/final/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "final_review", "kind": "finding", "path": "striatum/0041-web-hosted-browser-acceptance/final/FINAL_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_browser", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [{"from": "final_review", "to": "implement_findings", "on_verdict": "needs_revision", "max_iterations": 1}]
}
