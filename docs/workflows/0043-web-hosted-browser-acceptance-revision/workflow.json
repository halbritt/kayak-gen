{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0043-web-hosted-browser-acceptance-revision",
  "workflow_version": "2026-05-13",
  "name": "0043 - Web hosted browser acceptance revision",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0043-web-hosted-browser-acceptance-revision",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "review_revision_policy": {
    "root_review_needs_revision": "declared_cycle",
    "description": "First-pass review needs_revision verdicts route through review_revision_anchor for bounded remediation and re-review."
  },
  "lanes": {
    "claude": {"adapter": "process", "display_model": "Claude Opus 4.7", "command": ["claude", "--model", "opus", "-p"], "capabilities": ["review", "synthesis"]},
    "codex": {"adapter": "process", "display_model": "Codex GPT-5.5", "command": ["codex", "exec", "--model", "gpt-5.5", "-"], "capabilities": ["write", "review", "synthesis"]},
    "gemini": {"adapter": "process", "display_model": "Gemini Pro 3.1", "command": ["gemini", "--model", "gemini-3.1-pro-preview"], "capabilities": ["review"]}
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "review_anchor": {"definition_path": "roles/review_anchor.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_browser": {"definition_path": "roles/reviewer_browser.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/PRD.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "docs/WEB_VERIFICATION.md", "required": true},
    {"path": "docs/rfcs/0008-web-frontend.md", "required": true},
    {"path": "docs/rfcs/0018-web-cfd-job-routes.md", "required": true},
    {"path": "docs/rfcs/0030-web-hosted-browser-acceptance.md", "required": true},
    {"path": "docs/rfcs/0032-web-hosted-browser-acceptance-revision.md", "required": true},
    {"path": "docs/workflows/0041-web-hosted-browser-acceptance/SOURCES.md", "required": true},
    {"path": "docs/workflows/0041-web-hosted-browser-acceptance/workflow.json", "required": true},
    {"path": "docs/workflows/0029-web-cfd-job-routes/workflow.json", "required": true},
    {"path": "docs/workflows/0037-first-real-cfd-fixture-adapter/workflow.json", "required": true},
    {"path": "striatum/0041-web-hosted-browser-acceptance/traceability/REVIEW_TRACEABILITY.md", "required": false},
    {"path": "striatum/0041-web-hosted-browser-acceptance/browser/REVIEW_BROWSER.md", "required": false},
    {"path": "striatum/0041-web-hosted-browser-acceptance/ops/REVIEW_OPS.md", "required": false},
    {"path": "kayakgen/ui/web", "required": false},
    {"path": "kayakgen/cli", "required": false},
    {"path": "tests/test_web.py", "required": false},
    {"path": "tests/test_web_browser.py", "required": false},
    {"path": "Dockerfile", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "review_revision_anchor",
      "type": "draft",
      "title": "Anchor first-pass review revision scope",
      "role_id": "review_anchor",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Carry forward 0041 blocker context and provide the bounded remediation anchor that feeds the three first-pass reviews.",
      "task_prompt": {"path": "prompts/review_revision_anchor.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/review_anchor/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review_scope", "kind": "handoff", "path": "striatum/0043-web-hosted-browser-acceptance-revision/review_anchor/REVIEW_SCOPE.md", "required": true}]
    },
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review web acceptance traceability revision",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0032 to RFC 0030, RFC 0008 partials, 0041 blocker findings, web UI behavior, deployment docs, and tests.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/traceability/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0043-web-hosted-browser-acceptance-revision/traceability/REVIEW_TRACEABILITY.md", "required": true}]
    },
    {
      "id": "review_browser",
      "type": "review",
      "title": "Review browser acceptance revision",
      "role_id": "reviewer_browser",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review required real-browser acceptance, console/network cleanliness, Lighthouse handling, 3D nonblank checks, share/export behavior, and plot/dashboard boundaries.",
      "task_prompt": {"path": "prompts/review_browser.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/browser/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0043-web-hosted-browser-acceptance-revision/browser/REVIEW_BROWSER.md", "required": true}]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review web acceptance ops and tests revision",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review hosted-demo documentation, Docker/local serve behavior, required browser-tooling failure behavior, CFD route dependency states, and deterministic tests.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/ops/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0043-web-hosted-browser-acceptance-revision/ops/REVIEW_OPS.md", "required": true}]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate web acceptance revision findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate review findings and define the safe implementation slice for RFC 0032.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/ledger/", "docs/workflows/0043-web-hosted-browser-acceptance-revision/OPERATOR_REPORT.md"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "ledger", "kind": "findings_ledger", "path": "striatum/0043-web-hosted-browser-acceptance-revision/ledger/FINDINGS.md", "required": true}]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement web hosted browser acceptance revision",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement accepted local browser-acceptance and hosted-demo documentation work while preserving explicit raw/unvalidated CFD states.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/", "kayakgen/ui/web/", "kayakgen/cli/", "tests/", "pyproject.toml", "Dockerfile", ".dockerignore", "striatum/0043-web-hosted-browser-acceptance-revision/implementation/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0043-web-hosted-browser-acceptance-revision/implementation/PATCH_SUMMARY.md", "required": true}]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for web hosted browser acceptance revision",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify RFC 0032 browser gates, hosted-demo docs, console/network cleanliness, Lighthouse handling, parity boundaries, CFD route dependency states, and test evidence.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0043-web-hosted-browser-acceptance-revision/final/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "final_review", "kind": "finding", "path": "striatum/0043-web-hosted-browser-acceptance-revision/final/FINAL_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "review_revision_anchor", "to": "review_traceability", "on": "completed"},
    {"from": "review_revision_anchor", "to": "review_browser", "on": "completed"},
    {"from": "review_revision_anchor", "to": "review_ops", "on": "completed"},
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_browser", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_traceability", "to": "review_revision_anchor", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_browser", "to": "review_revision_anchor", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_ops", "to": "review_revision_anchor", "on_verdict": "needs_revision", "max_iterations": 1, "allow_same_lane": true},
    {"from": "final_review", "to": "implement_findings", "on_verdict": "needs_revision", "max_iterations": 1}
  ]
}
