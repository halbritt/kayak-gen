{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0013-resistance-acceptance-revision",
  "workflow_version": "2026-05-13",
  "name": "0013 - Resistance acceptance revision",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0013-resistance-acceptance-revision",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain": {"definition_path": "roles/reviewer_domain.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/rfcs/0005-cfd-resistance.md", "required": true},
    {"path": "docs/rfcs/0012-resistance-model-calibration.md", "required": true},
    {"path": "docs/rfcs/0013-pareto-frontier-comparison-ui.md", "required": true},
    {"path": "docs/workflows/0013-resistance-acceptance-revision/SOURCES.md", "required": true},
    {"path": "striatum/0012-resistance-calibration-source-review/ledger/FINDINGS.md", "required": true},
    {"path": "striatum/0012-resistance-calibration-source-review/final/FINAL_REVIEW.md", "required": true},
    {"path": "kayakgen/eval/resistance.py", "required": true},
    {"path": "kayakgen/eval/calibration.py", "required": true},
    {"path": "tests/test_resistance.py", "required": true},
    {"path": "pyproject.toml", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review RFC/test traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review RFC 0005/0012 acceptance claims and resistance tests after the 0012 source gate.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0013-resistance-acceptance-revision/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0013-resistance-acceptance-revision/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review resistance-domain claims",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review which raw resistance claims are defensible and which must remain future calibration work.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0013-resistance-acceptance-revision/domain/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0013-resistance-acceptance-revision/domain/REVIEW_DOMAIN.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review resistance tests and ops",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review test cleanup, performance budget, and package/API impact for resistance acceptance revision.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0013-resistance-acceptance-revision/ops/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0013-resistance-acceptance-revision/ops/REVIEW_OPS.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate resistance acceptance findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate findings and define the safe acceptance-revision patch.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0013-resistance-acceptance-revision/ledger/",
          "docs/workflows/0013-resistance-acceptance-revision/OPERATOR_REPORT.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0013-resistance-acceptance-revision/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement resistance acceptance revision",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement safe RFC/test revisions from the ledger without adding calibration.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/rfcs/",
          "docs/workflows/0013-resistance-acceptance-revision/",
          "kayakgen/",
          "tests/",
          "striatum/0013-resistance-acceptance-revision/implementation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0013-resistance-acceptance-revision/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for resistance acceptance revision",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify that resistance acceptance claims and tests are truthful after revision.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0013-resistance-acceptance-revision/final/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0013-resistance-acceptance-revision/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
