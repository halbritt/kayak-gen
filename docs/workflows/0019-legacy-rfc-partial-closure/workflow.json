      "title": "Review legacy RFC implementation shape",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review implementation, CLI/web/desktop propagation, and tests for RFC 0004/0006 closure.",
