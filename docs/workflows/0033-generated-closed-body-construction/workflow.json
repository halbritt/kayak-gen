    {"path": "docs/rfcs/0022-generated-closed-body-construction.md", "required": true},
    {"path": "docs/workflows/0027-closed-volume-geometry-contract/OPERATOR_REPORT.md", "required": true},
    {"path": "kayakgen/eval/closed_volume.py", "required": true},
    {"path": "kayakgen/geometry/lofted_hull.py", "required": true},
    {"path": "kayakgen/domain/hull.py", "required": true},
