      "id": "review_ops_test",
      "type": "review",
      "title": "Review generated closed-body ops and tests",
      "role_id": "reviewer_ops_test",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify implementation boundaries, fixtures, serialization, CLI/JSON behavior, display STL separation, and tests.",
