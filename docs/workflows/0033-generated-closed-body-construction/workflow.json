      "title": "Implement generated closed-body construction",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement deterministic generated closed-body construction for evaluation diagnostics without CFD readiness.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/",
          "kayakgen/domain/",
          "kayakgen/geometry/",
          "kayakgen/eval/",
          "kayakgen/cli/",
          "tests/",
          "striatum/0033-generated-closed-body-construction/implementation/"
