{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0050-decision-panel-research",
  "workflow_version": "2026-05-14",
  "name": "0050 - Decision panel research",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0050-decision-panel-research",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "claude"
  },
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex",
        "exec",
        "--model",
        "gpt-5.5",
        "--dangerously-bypass-approvals-and-sandbox",
        "-"
      ],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review", "synthesis"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "researcher": {"definition_path": "roles/researcher.md"},
    "panelist": {"definition_path": "roles/panelist.md"},
    "decision_integrator": {"definition_path": "roles/decision_integrator.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/PRD.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "docs/ROADMAP.md", "required": true},
    {"path": "docs/DECISION_LOG.md", "required": true},
    {"path": "docs/rfcs/README.md", "required": true},
    {"path": "docs/design/kayak_hull_design_constraints.md", "required": true},
    {"path": "docs/workflows/0018-deferred-backlog/QUEUE.md", "required": true},
    {"path": "striatum/0049-roadmap-reconciliation/final/FINAL_REVIEW.md", "required": true},
    {"path": "striatum/0049-roadmap-reconciliation/integration/PATCH_SUMMARY.md", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 12,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "research_solver_path",
      "type": "synthesis",
      "title": "Research CFD solver path decision",
      "role_id": "researcher",
      "lane_id": "codex",
      "parallel_group": "decision_research",
      "fresh_session_required": true,
      "objective": "Research the CFD solver path decision: first external solver target, mesh profile/readiness gate, case-template version, parser scope, install/platform notes, and CI strategy.",
      "task_prompt": {"path": "prompts/research_decision.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0050-decision-panel-research/research/solver_path/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "research", "kind": "synthesis", "path": "striatum/0050-decision-panel-research/research/solver_path/RESEARCH.md", "required": true}]
    },
    {
      "id": "research_solver_readiness",
      "type": "synthesis",
      "title": "Research solver-readiness evidence decision",
      "role_id": "researcher",
      "lane_id": "codex",
      "parallel_group": "decision_research",
      "fresh_session_required": true,
      "objective": "Research the solver-readiness evidence decision: generated-body diagnostics, volume-mesh diagnostic schema, quality thresholds, artifact hashes, blocker/warning semantics, and `cfd_ready` promotion rules.",
