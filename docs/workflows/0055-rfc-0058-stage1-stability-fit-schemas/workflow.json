      "type": "synthesis",
      "title": "Synchronize docs for RFC 0058 stage 1 schema landing",
      "role_id": "implementer",
      "lane_id": "codex",
      "parallel_group": "stage1_implementation",
      "fresh_session_required": true,
      "objective": "Update CHANGELOG.md (new ### Added entry under Unreleased), docs/DECISION_LOG.md (new D038 row), docs/ROADMAP.md (add a 'Stability calibration acceptance' track row between the calibration-campaign tooling row and existing rows), docs/rfcs/0058-stability-calibration-acceptance.md (flip Status from 'proposed' to 'landed (schemas only)' with a Stage 1 implementation note paragraph), docs/rfcs/README.md (status update for RFC 0058), and this workflow's OPERATOR_REPORT.md. Do not change runtime behavior or no-claims boundaries. Do not touch the implementer track's files.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "CHANGELOG.md",
          "docs/DECISION_LOG.md",
          "docs/ROADMAP.md",
          "docs/rfcs/README.md",
          "docs/rfcs/0058-stability-calibration-acceptance.md",
