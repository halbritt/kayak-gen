          "striatum/0055-rfc-0058-stage1-stability-fit-schemas/implementation/docs_sync/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0055-rfc-0058-stage1-stability-fit-schemas/implementation/docs_sync/PATCH_SUMMARY.md", "required": true}
      ]
