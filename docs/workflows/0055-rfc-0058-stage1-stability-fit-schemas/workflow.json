      "task_prompt": {"path": "prompts/review.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0055-rfc-0058-stage1-stability-fit-schemas/reviews/claims/"], "forbidden_paths": [".striatum/"]},
