      "id": "implement_stability_fit_schemas",
      "type": "synthesis",
      "title": "Implement RFC 0058 stage 1 stability-fit schemas",
      "role_id": "implementer",
      "lane_id": "codex",
      "parallel_group": "stage1_implementation",
      "fresh_session_required": true,
      "objective": "Build kayakgen/eval/stability/accepted_fit.py with the five Pydantic records in STAGE_1_DECISIONS.md (HullFamilyScope, StabilityFitMetrics, ReviewerSignature, StabilityFitRecord, StabilityFixturePromotionPacket) plus the FixtureRef value object, the four threshold constants, and the validators encoded as model_validators. No fixture or fit is promoted by this RFC — defaults stay validation_candidate / rejected. Sibling tests in tests/test_stability_accepted_fit.py covering: schema round-trip, threshold enforcement at the StabilityFitRecord level (both strict=True and strict=False), promotion-packet refusal when any review verdict is not 'accepted', and the FixtureRef SHA-256 shape check. Run focused tests + ruff before publishing the patch summary.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "kayakgen/eval/stability/accepted_fit.py",
          "tests/test_stability_accepted_fit.py",
          "striatum/0055-rfc-0058-stage1-stability-fit-schemas/implementation/stability_fit_schemas/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0055-rfc-0058-stage1-stability-fit-schemas/implementation/stability_fit_schemas/PATCH_SUMMARY.md", "required": true}
      ]
    },
