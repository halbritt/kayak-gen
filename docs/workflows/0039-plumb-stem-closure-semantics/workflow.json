{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0039-plumb-stem-closure-semantics",
  "workflow_version": "2026-05-13",
  "name": "0039 - Plumb-stem closure semantics",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0039-plumb-stem-closure-semantics",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {"adapter": "process", "display_model": "Claude Opus 4.7", "command": ["claude", "--model", "opus", "-p"], "capabilities": ["review", "synthesis"]},
    "codex": {"adapter": "process", "display_model": "Codex GPT-5.5", "command": ["codex", "exec", "--model", "gpt-5.5", "-"], "capabilities": ["write", "review", "synthesis"]},
    "gemini": {"adapter": "process", "display_model": "Gemini Pro 3.1", "command": ["gemini", "--model", "gemini-3.1-pro-preview"], "capabilities": ["review"]}
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain": {"definition_path": "roles/reviewer_domain.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/rfcs/0004-plumb-bow.md", "required": true},
    {"path": "docs/rfcs/0028-plumb-stem-closure-semantics.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "kayakgen/model/hull.py", "required": false},
    {"path": "kayakgen/geometry/loft.py", "required": false},
    {"path": "kayakgen/mesh/diagnostics.py", "required": false},
    {"path": "tests", "required": true}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review plumb-stem traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0028 semantics to RFC 0004 deferrals, closed-body dependencies, CLI/user-guide wording, and tests.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0039-plumb-stem-closure-semantics/traceability/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0039-plumb-stem-closure-semantics/traceability/REVIEW_TRACEABILITY.md", "required": true}]
    },
    {
      "id": "review_domain",
      "type": "review",
      "title": "Review geometry domain semantics",
      "role_id": "reviewer_domain",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review coordinate/sign conventions, asymmetric rake semantics, endpoint cap geometry, and closed-body ownership boundaries.",
      "task_prompt": {"path": "prompts/review_domain.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0039-plumb-stem-closure-semantics/domain/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0039-plumb-stem-closure-semantics/domain/REVIEW_DOMAIN.md", "required": true}]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review plumb-stem ops and tests",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review migration, serialization, CLI docs, diagnostics, and tests needed for exact plumb caps without overclaiming readiness.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0039-plumb-stem-closure-semantics/ops/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "review", "kind": "finding", "path": "striatum/0039-plumb-stem-closure-semantics/ops/REVIEW_OPS.md", "required": true}]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate plumb-stem findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate review findings and define the safe implementation slice for RFC 0028.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["striatum/0039-plumb-stem-closure-semantics/ledger/", "docs/workflows/0039-plumb-stem-closure-semantics/OPERATOR_REPORT.md"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "ledger", "kind": "findings_ledger", "path": "striatum/0039-plumb-stem-closure-semantics/ledger/FINDINGS.md", "required": true}]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement plumb-stem closure semantics",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement accepted plumb-stem closure semantics while preserving default geometry and open-surface labels.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/", "kayakgen/", "tests/", "striatum/0039-plumb-stem-closure-semantics/implementation/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "patch_summary", "kind": "patch_summary", "path": "striatum/0039-plumb-stem-closure-semantics/implementation/PATCH_SUMMARY.md", "required": true}]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for plumb-stem closure",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify exact plumb semantics, asymmetric rake, cap orientation, diagnostics, and readiness wording.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["striatum/0039-plumb-stem-closure-semantics/final/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "final_review", "kind": "finding", "path": "striatum/0039-plumb-stem-closure-semantics/final/FINAL_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [{"from": "final_review", "to": "implement_findings", "on_verdict": "needs_revision", "max_iterations": 1}]
}
