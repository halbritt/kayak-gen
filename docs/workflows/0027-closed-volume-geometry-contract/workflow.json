{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0027-closed-volume-geometry-contract",
  "workflow_version": "2026-05-13",
  "name": "0027 - Closed-volume geometry contract",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0027-closed-volume-geometry-contract",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain_geometry": {"definition_path": "roles/reviewer_domain_geometry.md"},
    "reviewer_ops_test": {"definition_path": "roles/reviewer_ops_test.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/PRD.md", "required": true},
    {"path": "docs/design/kayak_hull_design_constraints.md", "required": true},
    {"path": "docs/rfcs/README.md", "required": true},
    {"path": "docs/rfcs/0004-plumb-bow.md", "required": true},
    {"path": "docs/rfcs/0006-design-constraints.md", "required": true},
    {"path": "docs/rfcs/0010-cfd-ready-mesh-contract.md", "required": true},
    {"path": "docs/rfcs/0015-cfd-solver-dispatch-and-jobs.md", "required": true},
    {"path": "docs/rfcs/0016-closed-volume-geometry.md", "required": true},
    {"path": "docs/workflows/0018-deferred-backlog/QUEUE.md", "required": true},
    {"path": "docs/workflows/0024-watertight-solid-mesh-profile/OPERATOR_REPORT.md", "required": true},
    {"path": "docs/workflows/0026-docs-roadmap-user-guide/OPERATOR_REPORT.md", "required": true},
    {"path": "kayakgen/model/geometry.py", "required": true},
    {"path": "kayakgen/eval/mesh_package.py", "required": true},
    {"path": "kayakgen/eval/cfd/jobs.py", "required": true},
    {"path": "kayakgen/cli/main.py", "required": true},
    {"path": "tests/test_mesh_package.py", "required": true},
    {"path": "tests/test_cfd_jobs.py", "required": true},
    {"path": "tests/test_cli.py", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review closed-volume traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0004, RFC 0006, RFC 0010, RFC 0015, and proposed RFC 0016 requirements to a safe closed-volume implementation slice.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0027-closed-volume-geometry-contract/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0027-closed-volume-geometry-contract/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain_geometry",
      "type": "review",
      "title": "Review domain and geometry contract",
      "role_id": "reviewer_domain_geometry",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review closure policy, hull-plus-deck semantics, normal orientation, manifold checks, volume boundaries, and waterline handling.",
      "task_prompt": {"path": "prompts/review_domain_geometry.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0027-closed-volume-geometry-contract/domain_geometry/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0027-closed-volume-geometry-contract/domain_geometry/REVIEW_DOMAIN_GEOMETRY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops_test",
      "type": "review",
      "title": "Review ops and tests",
      "role_id": "reviewer_ops_test",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Review deterministic artifacts, invalid synthetic meshes, CLI behavior, profile hooks, and test strategy for closed-volume diagnostics.",
      "task_prompt": {"path": "prompts/review_ops_test.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0027-closed-volume-geometry-contract/ops_test/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0027-closed-volume-geometry-contract/ops_test/REVIEW_OPS_TEST.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate closed-volume findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate closed-volume findings and define the safe implementation slice.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0027-closed-volume-geometry-contract/ledger/",
          "docs/workflows/0027-closed-volume-geometry-contract/OPERATOR_REPORT.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0027-closed-volume-geometry-contract/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement closed-volume geometry contract",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement only the closed-volume geometry contract accepted by the ledger and RFC 0016.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/",
          "kayakgen/model/",
          "kayakgen/eval/",
          "kayakgen/cli/",
          "tests/",
          "striatum/0027-closed-volume-geometry-contract/implementation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0027-closed-volume-geometry-contract/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for closed-volume geometry",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify closed-volume diagnostics, tests, truthful readiness/profile classification, and no relabeling of open surfaces.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0027-closed-volume-geometry-contract/final/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0027-closed-volume-geometry-contract/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain_geometry", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops_test", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
