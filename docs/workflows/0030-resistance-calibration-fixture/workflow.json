{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "0030-resistance-calibration-fixture",
  "workflow_version": "2026-05-13",
  "name": "0030 - Resistance calibration fixture",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/0030-resistance-calibration-fixture",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude"},
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--model", "gpt-5.5", "-"],
      "capabilities": ["write", "review", "synthesis"]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro 3.1",
      "command": ["gemini", "--model", "gemini-3.1-pro-preview"],
      "capabilities": ["review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "reviewer_traceability": {"definition_path": "roles/reviewer_traceability.md"},
    "reviewer_domain_source": {"definition_path": "roles/reviewer_domain_source.md"},
    "reviewer_ops": {"definition_path": "roles/reviewer_ops.md"},
    "ledger": {"definition_path": "roles/ledger.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "final_reviewer": {"definition_path": "roles/final_reviewer.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/PRD.md", "required": true},
    {"path": "docs/USER_GUIDE.md", "required": true},
    {"path": "docs/rfcs/README.md", "required": true},
    {"path": "docs/rfcs/0005-cfd-resistance.md", "required": true},
    {"path": "docs/rfcs/0012-resistance-model-calibration.md", "required": true},
    {"path": "docs/rfcs/0019-resistance-calibration-fixtures.md", "required": true},
    {"path": "docs/workflows/0018-deferred-backlog/QUEUE.md", "required": true},
    {"path": "docs/workflows/0023-resistance-calibration-dataset-vetting/OPERATOR_REPORT.md", "required": true},
    {"path": "kayakgen/eval/calibration.py", "required": true},
    {"path": "kayakgen/eval/resistance.py", "required": true},
    {"path": "kayakgen/cli/main.py", "required": true},
    {"path": "tests/test_resistance.py", "required": true}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "review_traceability",
      "type": "review",
      "title": "Review calibration fixture traceability",
      "role_id": "reviewer_traceability",
      "lane_id": "claude",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Map RFC 0012 and RFC 0019 acceptance requirements to current resistance code, dataset provenance, and docs.",
      "task_prompt": {"path": "prompts/review_traceability.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0030-resistance-calibration-fixture/traceability/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0030-resistance-calibration-fixture/traceability/REVIEW_TRACEABILITY.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_domain_source",
      "type": "review",
      "title": "Review dataset domain and source rights",
      "role_id": "reviewer_domain_source",
      "lane_id": "gemini",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify hull class, measurement type, units, licensing, extraction method, and whether any source is calibration-ready or validation-only.",
      "task_prompt": {"path": "prompts/review_domain_source.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0030-resistance-calibration-fixture/domain_source/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0030-resistance-calibration-fixture/domain_source/REVIEW_DOMAIN_SOURCE.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_ops",
      "type": "review",
      "title": "Review fixture ops and tests",
      "role_id": "reviewer_ops",
      "lane_id": "codex",
      "parallel_group": "reviews",
      "fresh_session_required": true,
      "objective": "Verify fixture size, provenance metadata, reproducible fitting boundaries, and no calibrated-claim leakage.",
      "task_prompt": {"path": "prompts/review_ops.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0030-resistance-calibration-fixture/ops/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "striatum/0030-resistance-calibration-fixture/ops/REVIEW_OPS.md",
          "required": true
        }
      ]
    },
    {
      "id": "findings_ledger",
      "type": "ledger",
      "title": "Consolidate calibration fixture findings",
      "role_id": "ledger",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Deduplicate findings and decide whether implementation may land a fixture, validation-only metadata, or a blocked status update.",
      "task_prompt": {"path": "prompts/findings_ledger.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/0030-resistance-calibration-fixture/ledger/",
          "docs/workflows/0030-resistance-calibration-fixture/OPERATOR_REPORT.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "ledger",
          "kind": "findings_ledger",
          "path": "striatum/0030-resistance-calibration-fixture/ledger/FINDINGS.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_findings",
      "type": "build",
      "title": "Implement calibration fixture slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Implement only the accepted calibration/validation fixture slice from the ledger.",
      "task_prompt": {"path": "prompts/implement_findings.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/",
          "kayakgen/eval/",
          "kayakgen/cli/",
          "tests/",
          "striatum/0030-resistance-calibration-fixture/implementation/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "patch_summary",
          "kind": "patch_summary",
          "path": "striatum/0030-resistance-calibration-fixture/implementation/PATCH_SUMMARY.md",
          "required": true
        }
      ]
    },
    {
      "id": "final_review",
      "type": "review",
      "title": "Final gate for calibration fixture",
      "role_id": "final_reviewer",
      "lane_id": "claude",
      "fresh_session_required": true,
      "objective": "Verify provenance, tests, and that resistance remains uncalibrated unless a true accepted fixture landed.",
      "task_prompt": {"path": "prompts/final_review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["striatum/0030-resistance-calibration-fixture/final/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_review",
          "kind": "finding",
          "path": "striatum/0030-resistance-calibration-fixture/final/FINAL_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "review_traceability", "to": "findings_ledger", "on": "completed"},
    {"from": "review_domain_source", "to": "findings_ledger", "on": "completed"},
    {"from": "review_ops", "to": "findings_ledger", "on": "completed"},
    {"from": "findings_ledger", "to": "implement_findings", "on": "completed"},
    {"from": "implement_findings", "to": "final_review", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "final_review",
      "to": "implement_findings",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
