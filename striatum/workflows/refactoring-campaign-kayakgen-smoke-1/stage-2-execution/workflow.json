{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "refactoring-campaign-kayakgen-smoke-1-execution",
  "workflow_version": "2026-06-05",
  "name": "Refactoring Campaign \u2014 Stage 2: Execution",
  "allow_same_model_review_pairing": true,
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/refactoring-campaign-kayakgen-smoke-1",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "refactoring_author",
    "lane_id": "author"
  },
  "lanes": {
    "author": {
      "adapter": "process",
      "display_model": "claude",
      "command": [
        "claude",
        "--dangerously-skip-permissions"
      ],
      "adapter_capabilities": {
        "agent_loop": true
      },
      "supervision": {
        "transport": "pty_helper",
        "compatible": true,
        "require_tmux": true
      },
      "capabilities": [
        "write"
      ],
      "worktree_isolation": "per_job"
    },
    "reviewer": {
      "adapter": "process",
      "display_model": "codex",
      "command": [
        "codex",
        "--yolo"
      ],
      "adapter_capabilities": {
        "agent_loop": true
      },
      "supervision": {
        "transport": "pty_helper",
        "compatible": true,
        "require_tmux": true
      },
      "capabilities": [
        "review"
      ]
    }
  },
  "roles": {
    "refactoring_author": {
      "definition_path": "roles/refactoring_author.md"
    },
    "preservation_reviewer": {
      "definition_path": "roles/preservation_reviewer.md"
    }
  },
  "context_docs": [
    {
      "path": "striatum/refactoring/kayakgen-smoke-1/00-goal/GOAL_DECISION.md",
      "required": false
    },
    {
      "path": "striatum/refactoring/kayakgen-smoke-1/01-plan/COMMITTED_PLAN.md",
      "required": false
    },
    {
      "path": "striatum/refactoring/kayakgen-smoke-1/01-plan/GATE_SUMMARY.md",
      "required": false
    }
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "execute_slices",
      "type": "draft",
      "title": "Execute plan slices",
      "role_id": "refactoring_author",
      "lane_id": "author",
      "objective": "Execute the committed plan's step table slice by slice in the isolated worktree, verifying each slice's preservation claim and recording evidence in the step ledger.",
      "task_prompt": {
        "path": "prompts/execute_slices.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "kayakgen/ui/web/",
          "kayakgen/cli/main.py",
          "tests/test_cli_serve.py",
          "tests/test_web_layout.py",
          "tests/test_web_inline_help.py",
          "tests/test_hydro_tab_descriptions.py",
          "tests/test_generative_jobs_web.py",
          "striatum/refactoring/kayakgen-smoke-1/02-execution/STEP_LEDGER.md"
        ],
        "forbidden_paths": [
          ".striatum/",
          ".gemini/",
          "tests/test_web_browser.py",
          "tests/test_import_boundaries.py",
          "tests/test_services_boundaries.py",
          "pyproject.toml"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "step_ledger",
          "kind": "support_ledger",
          "path": "striatum/refactoring/kayakgen-smoke-1/02-execution/STEP_LEDGER.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_preservation",
      "type": "review",
      "title": "Review preservation evidence",
      "role_id": "preservation_reviewer",
      "lane_id": "reviewer",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "devils_advocate",
      "objective": "Replay the verification commands against the executed slices and audit the step ledger: no new failures, frozen surfaces untouched, slices within their declared caps.",
      "task_prompt": {
        "path": "prompts/review_preservation.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "striatum/refactoring/kayakgen-smoke-1/02-execution/PRESERVATION_REVIEW.md"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "preservation_review",
          "kind": "finding",
          "path": "striatum/refactoring/kayakgen-smoke-1/02-execution/PRESERVATION_REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "finalize_report",
      "type": "draft",
      "title": "Finalize campaign report",
      "role_id": "refactoring_author",
      "lane_id": "author",
      "fresh_session_required": true,
      "objective": "Publish the final campaign report: goal provenance, baseline, step ledger summary, deviations, deferred findings, rollback map, and residual risk.",
      "task_prompt": {
        "path": "prompts/finalize_report.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "striatum/refactoring/kayakgen-smoke-1/02-execution/FINAL_REPORT.md"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "final_report",
          "kind": "synthesis",
          "path": "striatum/refactoring/kayakgen-smoke-1/02-execution/FINAL_REPORT.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "execute_slices",
      "to": "review_preservation",
      "on": "completed"
    },
    {
      "from": "review_preservation",
      "to": "finalize_report",
      "on": "completed"
    }
  ],
  "cycles": [
    {
      "from": "review_preservation",
      "to": "execute_slices",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}